# Copy to .env and enter your mail provider's SMTP settings.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=sender@example.com
# Single quotes protect special characters from Docker Compose interpolation.
SMTP_PASSWORD='replace-with-your-smtp-password'
MAIL_FROM=sender@example.com
RECIPIENTS=first@example.com,second@example.com

# main = Fuentenueva / Cartuja / Aynadamar; pts = the separate PTS menu.
MENU_LOCATION=main
TZ=Europe/Madrid
SEND_AT=09:00
# Retry missing menus and failed sends every 15 minutes, stopping before lunch.
RETRY_UNTIL=12:00
RETRY_SECONDS=900
