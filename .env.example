# Copy to .env and enter your mail provider's SMTP settings.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=sender@example.com
# Single quotes protect special characters from Docker Compose interpolation.
SMTP_PASSWORD='replace-with-your-smtp-password'
MAIL_FROM=sender@example.com
RECIPIENTS=first@example.com,second@example.com
# Only the explicit test-email command uses this separate list.
TEST_RECIPIENTS=tester@example.com

# main = Fuentenueva / Cartuja / Aynadamar; pts = the separate PTS menu.
MENU_LOCATION=main
# Search Commons each day for starter and main photos; false keeps emails text-only.
IMAGE_SEARCH_ENABLED=true
# Optional: identify your deployment with a project URL or contact in the API user agent.
# IMAGE_USER_AGENT='UGRComedorDaily/1.0 (https://github.com/your-user/your-project)'
TZ=Europe/Madrid
SEND_AT=09:00
# Retry missing menus and failed sends every 15 minutes, stopping before lunch.
RETRY_UNTIL=12:00
RETRY_SECONDS=900
